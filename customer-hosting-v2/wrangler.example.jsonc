// Candidate for the registered customer-only zone. Use only with --dry-run
// until the owner approves live routing in DNS_CUTOVER_CHECKLIST.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sho-customer-sites",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"CUSTOMER_BASE_DOMAIN": "sho-websites.com"},
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "sho-customer-sites-production",
      "preview_bucket_name": "sho-customer-sites-preview"
    }
  ],
  "routes": [
    {
      "pattern": "https://*.sho-websites.com/*",
      "zone_name": "sho-websites.com"
    }
  ]
}
